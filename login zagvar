// Алхам 1: Хэрэглэгч байгаа эсэхийг шалгах
sendResetBtn.onclick = () => {
  clearErrors();
  const id = resetIdInput.value.trim().toLowerCase();
  if (!id) {
    resetError.textContent = "Утас эсвэл Имэйлээ оруулна уу";
    return;
  }

  userFound = null;
  for (let i = 0; i < localStorage.length; i++) {
    const key = localStorage.key(i);
    if (key.startsWith("user_")) {
      const user = JSON.parse(localStorage.getItem(key));
      if (user.phone === id || user.email.toLowerCase() === id) {
        userFound = { user, key };
        break;
      }
    }
  }

  if (!userFound) {
    resetError.textContent = "Хэрэглэгч олдсонгүй";
    return;
  }

  currentUserKey = userFound.key;
  secretQuestionSection.style.display = "block";
  secretQuestionText.textContent = `Нууц асуулт: ${
    userFound.user.secretQuestion === "1"
      ? "Таны хамгийн дуртай амттан юу вэ?"
      : userFound.user.secretQuestion === "2"
      ? "Таны төрсөн хот хаана вэ?"
      : "Таны анхны сургуулийн нэр?"
  }`;
};

// Алхам 2: Нууц асуултын хариултыг шалгах
verifyAnswerBtn.onclick = () => {
  clearErrors();
  const userAnswer = secretAnswerInput.value.trim().toLowerCase();
  if (!userAnswer) {
    answerError.textContent = "Хариултаа оруулна уу";
    return;
  }

  if (userAnswer !== userFound.user.secretAnswer.toLowerCase()) {
    answerError.textContent = "Хариулт буруу байна";
    return;
  }

  // Зөв хариулт
  newPasswordSection.style.display = "block";
  answerError.textContent = "";
};

// Алхам 3: Шинэ нууц үг солих
setNewPasswordBtn.onclick = () => {
  clearErrors();
  const newPass = newPasswordInput.value.trim();

  if (newPass.length < 6) {
    newPassError.textContent = "Нууц үг хамгийн багадаа 6 тэмдэгт байх ёстой";
    return;
  }

  const userData = userFound.user;
  userData.password = newPass;
  localStorage.setItem(currentUserKey, JSON.stringify(userData));

  alert("Нууц үг амжилттай солигдлоо! Одоо нэвтэрнэ үү.");
  resetModal.style.display = "none";

  // Инпут, алдааг цэвэрлэх
  resetIdInput.value = "";
  secretAnswerInput.value = "";
  newPasswordInput.value = "";
  clearErrors();
};
