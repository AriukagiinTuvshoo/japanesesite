  <script>
    const btnLogin = document.getElementById("btnLogin");
    const btnSignup = document.getElementById("btnSignup");
    const loginForm = document.getElementById("loginForm");
    const signupForm = document.getElementById("signupForm");
    const switchToLogin = document.getElementById("switchToLogin");
    const loginError = document.getElementById("loginError");
    const signupError = document.getElementById("signupError");
    const phoneError = document.getElementById("phoneError");

    const forgotPassLink = document.getElementById("forgotPass");
    const resetModal = document.getElementById("resetModal");
    const closeModalBtn = document.getElementById("closeModal");
    const resetIdInput = document.getElementById("resetId");
    const sendResetBtn = document.getElementById("sendReset");
    const resetError = document.getElementById("resetError");

    const secretQuestionSection = document.getElementById("secretQuestionSection");
    const secretQuestionText = document.getElementById("secretQuestionText");
    const secretAnswerInput = document.getElementById("secretAnswerInput");
    const verifyAnswerBtn = document.getElementById("verifyAnswerBtn");
    const answerError = document.getElementById("answerError");

    const newPasswordSection = document.getElementById("newPasswordSection");
    const newPasswordInput = document.getElementById("newPasswordInput");
    const setNewPasswordBtn = document.getElementById("setNewPasswordBtn");
    const newPassError = document.getElementById("newPassError");

    let currentUserKey = null;

    // Toggle forms
    btnLogin.onclick = () => {
      btnLogin.classList.add("active");
      btnSignup.classList.remove("active");
      loginForm.style.display = "block";
      signupForm.style.display = "none";
      clearErrors();
    };
    btnSignup.onclick = () => {
      btnSignup.classList.add("active");
      btnLogin.classList.remove("active");
      signupForm.style.display = "block";
      loginForm.style.display = "none";
      clearErrors();
    };
    switchToLogin.onclick = () => {
      btnLogin.click();
    };

    // Clear error messages
    function clearErrors() {
      loginError.textContent = "";
      signupError.textContent = "";
      phoneError.textContent = "";
      resetError.textContent = "";
      answerError.textContent = "";
      newPassError.textContent = "";
    }

    // Phone validation function
    function validatePhone(phone) {
      const phoneRegex = /^(\+976)?\d{8}$/;
      return phoneRegex.test(phone);
    }

    // Signup logic
    signupForm.onsubmit = (e) => {
      e.preventDefault();
      clearErrors();

      const name = document.getElementById("signName").value.trim();
      const phone = document.getElementById("signPhone").value.trim();
      const email = document.getElementById("signEmail").value.trim().toLowerCase();
      const password = document.getElementById("signPassword").value;
      const secretQuestion = document.getElementById("signSecretQuestion").value;
      const secretAnswer = document.getElementById("signSecretAnswer").value.trim().toLowerCase();

      if (!name || !phone || !email || !password || !secretQuestion || !secretAnswer) {
        signupError.textContent = "Бүх талбарыг зөв бөглөнө үү";
        return;
      }
      if (!validatePhone(phone)) {
        phoneError.textContent = "Утасны дугаар буруу байна. +97612345678 эсвэл 8 оронтой дугаар оруулна уу";
        return;
      }

      // Check duplicates
      for (let i=0; i < localStorage.length; i++) {
        const key = localStorage.key(i);
        if (key.startsWith("user_")) {
          const user = JSON.parse(localStorage.getItem(key));
          if (user.phone === phone) {
            signupError.textContent = "Утасны дугаар аль хэдийн бүртгэлтэй байна";
            return;
          }
          if (user.email === email) {
            signupError.textContent = "Имэйл аль хэдийн бүртгэлтэй байна";
            return;
          }
        }
      }

      const newUser = {
        name,
        phone,
        email,
        password,
        secretQuestion,
        secretAnswer,
      };

      localStorage.setItem("user_" + phone, JSON.stringify(newUser));
      alert("Амжилттай бүртгүүллээ! Одоо нэвтэрнэ үү.");
      btnLogin.click();
    };

    // Login logic
loginForm.onsubmit = (e) => {
