# JLPT Master Mongolia — Environment Variables
# Copy to .env.local and fill in values

# Supabase Auth + Data API (publishable key is safe for browser use; RLS is mandatory)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Backward compatibility only; prefer the publishable key above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required in production for login/signup throttling; leave unset only for local development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Google TTS for audio
GOOGLE_TTS_API_KEY=your-google-tts-key
